# Copy this file to .env in the repository root for local development.
# Comma-separated browser origins allowed to call the API.
CLUSTERDRIVE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Separate gRPC storage processes. Each node writes only to its own directory.
CLUSTERDRIVE_STORAGE_NODES=node-01=storage-node-01:50051,node-02=storage-node-02:50051,node-03=storage-node-03:50051
CLUSTERDRIVE_REPLICATION_FACTOR=2
CLUSTERDRIVE_CHUNK_SIZE_BYTES=1048576
CLUSTERDRIVE_METADATA_PATH=/app/data/metadata.json
CLUSTERDRIVE_METADATA_NODES=metadata-01=metadata-01:50161,metadata-02=metadata-02:50161,metadata-03=metadata-03:50161
CLUSTERDRIVE_METADATA_STATE_DIR=/app/data/metadata-nodes
# Deadlines for API gRPC calls; longer values tolerate Docker Desktop startup load.
CLUSTERDRIVE_STORAGE_RPC_TIMEOUT_SECONDS=5.0
CLUSTERDRIVE_METADATA_RPC_TIMEOUT_SECONDS=5.0
# Raft timing tolerances for Docker Desktop and local development.
CLUSTERDRIVE_RAFT_HEARTBEAT_INTERVAL_SECONDS=0.5
CLUSTERDRIVE_RAFT_ELECTION_TIMEOUT_MIN_SECONDS=5.0
CLUSTERDRIVE_RAFT_ELECTION_TIMEOUT_MAX_SECONDS=8.0
CLUSTERDRIVE_RAFT_RPC_TIMEOUT_SECONDS=2.0
CLUSTERDRIVE_REDIS_URL=redis://redis:6379/0
CLUSTERDRIVE_METADATA_CACHE_TTL_SECONDS=60
CLUSTERDRIVE_FRONTEND_PORT=5174
CLUSTERDRIVE_API_PORT=8001
CLUSTERDRIVE_LOG_LEVEL=INFO

# Storage node process settings (set separately for each node terminal).
# CLUSTERDRIVE_NODE_ID=node-01
# CLUSTERDRIVE_NODE_PORT=50051
# CLUSTERDRIVE_NODE_STORAGE_DIR=./data/storage/node-01
# CLUSTERDRIVE_NODE_CAPACITY_BYTES=0
